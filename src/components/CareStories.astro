---
import { Image } from 'astro:assets';
import healthMain from '../assets/line_oa_chat_261028_111903.jpg';
import healthDetail from '../assets/line_oa_chat_261028_111908.jpg';
import beautyMain from '../assets/line_oa_chat_261028_111901.jpg';
import beautyDetail from '../assets/line_oa_chat_261028_112001.jpg';
import facialMain from '../assets/line_oa_chat_261028_112009.jpg';
import facialDetail from '../assets/line_oa_chat_261028_111911.jpg';
import ReleaseSection from './ReleaseSection.astro';
---
<div class="care-stories" id="care">
  <article class="care-story care-story--health" aria-labelledby="care-health-title">
    <div class="care-story__text" data-reveal>
      <p class="eyebrow" lang="en"><span>01</span> HEALTH</p>
      <h3 id="care-health-title">身体と向き合う、<br />鍼灸・ボディケア。</h3>
      <p>身体のこわばりや、日々のコンディション。<br />まずは気になることをお聞かせください。<br />体質やその日の状態に合わせて、<br />鍼灸と手によるケアを組み合わせます。</p>
    </div>
    <figure class="care-story__main"><div class="image-reveal" data-image-reveal><Image src={healthMain} alt="背中に鍼を施すケアのイメージ" width={920} widths={[460, 690, 920]} sizes="(max-width: 767px) 88vw, 54vw" quality={86} /></div><figcaption>身体に向き合う、丁寧な時間。</figcaption></figure>
    <figure class="care-story__detail"><div class="image-reveal" data-image-reveal><Image src={healthDetail} alt="首もとから肩にかけて手でケアするイメージ" width={560} widths={[280, 420, 560]} sizes="(max-width: 767px) 57vw, 29vw" quality={85} /></div></figure>
  </article>
  <article class="care-story care-story--beauty" aria-labelledby="care-beauty-title">
    <div class="care-story__text" data-reveal>
      <p class="eyebrow" lang="en"><span>02</span> BEAUTY</p>
      <h3 id="care-beauty-title">美容鍼で向き合う、<br />あなた本来の美しさ。</h3>
      <p>フェイスラインやむくみなど、<br />顔まわりのお悩みを伺いながら。<br />美容鍼を通じて、素肌や表情と向き合う時間を。<br />内側からの美しさを大切に考えます。</p>
    </div>
    <figure class="care-story__main"><div class="image-reveal" data-image-reveal><Image src={beautyMain} alt="顔まわりに鍼を施す美容ケアのイメージ" width={920} widths={[460, 690, 920]} sizes="(max-width: 767px) 88vw, 54vw" quality={86} /></div><figcaption>自分らしさを見つめる、ひととき。</figcaption></figure>
    <figure class="care-story__detail"><div class="image-reveal" data-image-reveal><Image src={beautyDetail} alt="顔まわりへの美容鍼の施術風景" width={560} widths={[280, 420, 560]} sizes="(max-width: 767px) 57vw, 29vw" quality={85} /></div></figure>
  </article>
  <article class="care-story care-story--facial" aria-labelledby="care-facial-title">
    <div class="care-story__text" data-reveal>
      <p class="eyebrow" lang="en"><span>03</span> FACIAL CARE</p>
      <h3 id="care-facial-title">素肌と顔まわりを、<br />丁寧に見つめる。</h3>
      <p>フェイシャルや機器を用いたケアで、<br />顔まわりから首もとまで。<br />お肌のこと、ご希望のことを伺いながら、<br />一人ひとりに合わせてケアを考えます。</p>
    </div>
    <figure class="care-story__main"><div class="image-reveal" data-image-reveal><Image src={facialMain} alt="機器を使って顔まわりをケアする施術風景" width={800} widths={[400, 600, 800]} sizes="(max-width: 767px) 75vw, 42vw" quality={86} /></div><figcaption>自分の素肌と、ゆっくり向き合う。</figcaption></figure>
    <figure class="care-story__detail"><div class="image-reveal" data-image-reveal><Image src={facialDetail} alt="首もとと肩の自然なラインを表す美容イメージ" width={640} widths={[320, 480, 640]} sizes="(max-width: 767px) 62vw, 35vw" quality={85} /></div></figure>
  </article>
  <ReleaseSection />
</div>
