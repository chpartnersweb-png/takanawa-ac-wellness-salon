---
import { Image } from 'astro:assets';
import healthMain from '../assets/line_oa_chat_261028_111903.jpg';
import healthDetail from '../assets/line_oa_chat_261028_111908.jpg';
import beautyMain from '../assets/line_oa_chat_261028_111901.jpg';
import beautyDetail from '../assets/line_oa_chat_261028_111911.jpg';
import postureMain from '../assets/line_oa_chat_261028_111907.jpg';
import postureDetail from '../assets/line_oa_chat_261028_111910.jpg';
---
<div class="care-stories">
  <article class="care-story care-story--health" aria-labelledby="care-health-title">
    <div class="care-story__text" data-reveal>
      <p class="eyebrow" lang="en"><span>01</span> HEALTH</p>
      <h3 id="care-health-title">身体と向き合う、<br />鍼灸・ボディケア。</h3>
      <p>首や肩まわりの重さ、<br />身体のこわばりが気になる方へ。<br />体質やその日の状態に合わせて、<br />鍼灸と手によるケアを組み合わせます。</p>
    </div>
    <figure class="care-story__main"><div class="image-reveal" data-image-reveal><Image src={healthMain} alt="背中に鍼を施すケアのイメージ" width={920} widths={[460, 690, 920]} sizes="(max-width: 767px) 88vw, 54vw" quality={86} /></div><figcaption>身体に向き合う、丁寧な時間。</figcaption></figure>
    <figure class="care-story__detail"><div class="image-reveal" data-image-reveal><Image src={healthDetail} alt="首もとから肩にかけて手でケアするイメージ" width={560} widths={[280, 420, 560]} sizes="(max-width: 767px) 57vw, 29vw" quality={85} /></div></figure>
  </article>
  <article class="care-story care-story--beauty" aria-labelledby="care-beauty-title">
    <div class="care-story__text" data-reveal>
      <p class="eyebrow" lang="en"><span>02</span> BEAUTY</p>
      <h3 id="care-beauty-title">美容鍼と機器で、<br />自分らしい美しさへ。</h3>
      <p>フェイスラインやむくみなど、<br />顔まわりのお悩みを伺いながら。<br />美容鍼や機器を用いたケアで、<br />一人ひとりの美容に向き合います。</p>
    </div>
    <figure class="care-story__main"><div class="image-reveal" data-image-reveal><Image src={beautyMain} alt="顔まわりに鍼を施す美容ケアのイメージ" width={920} widths={[460, 690, 920]} sizes="(max-width: 767px) 88vw, 54vw" quality={86} /></div><figcaption>自分らしさを見つめる、ひととき。</figcaption></figure>
    <figure class="care-story__detail"><div class="image-reveal" data-image-reveal><Image src={beautyDetail} alt="自然な首もとと肩のラインを表した美容イメージ" width={560} widths={[280, 420, 560]} sizes="(max-width: 767px) 57vw, 29vw" quality={85} /></div></figure>
  </article>
  <article class="care-story care-story--posture" aria-labelledby="care-posture-title">
    <div class="care-story__text" data-reveal>
      <p class="eyebrow" lang="en"><span>03</span> POSTURE</p>
      <h3 id="care-posture-title">肩甲骨から見つめる、<br />しなやかな立ち姿。</h3>
      <p>巻き肩や猫背、<br />肩甲骨まわりの重さが気になる方へ。<br />肩甲骨リリースと整体によるケアで、<br />日常にも大切な一日にも寄り添います。</p>
    </div>
    <figure class="care-story__main"><div class="image-reveal" data-image-reveal><Image src={postureMain} alt="髪をまとめた女性の肩から背中にかけての立ち姿" width={800} widths={[400, 600, 800]} sizes="(max-width: 767px) 75vw, 42vw" quality={86} /></div><figcaption>日常から、大切な一日まで。</figcaption></figure>
    <figure class="care-story__detail"><div class="image-reveal" data-image-reveal><Image src={postureDetail} alt="肩から背中にかけて手で丁寧にケアするイメージ" width={640} widths={[320, 480, 640]} sizes="(max-width: 767px) 62vw, 35vw" quality={85} /></div></figure>
  </article>
</div>
