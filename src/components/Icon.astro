---
interface Props {
  name?: 'arrow' | 'external' | 'down' | 'instagram' | 'pin' | 'phone' | 'chat';
  class?: string;
}
const { name = 'external', class: className = '' } = Astro.props;
---
<svg class:list={['icon', className]} width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'external' && <><path d="M5 19 19 5M5 5h14v14" /></>}
  {name === 'arrow' && <><path d="M4 12h16m-6-6 6 6-6 6" /></>}
  {name === 'down' && <><path d="M12 3v18m-6-6 6 6 6-6" /></>}
  {name === 'instagram' && <><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r=".8" fill="currentColor" stroke="none" /></>}
  {name === 'pin' && <><path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z" /><circle cx="12" cy="10" r="2.5" /></>}
  {name === 'phone' && <><path d="m8 3 3 5-3 3a15 15 0 0 0 5 5l3-3 5 3-1 4c-8 2-19-9-17-17l5-1Z" /></>}
  {name === 'chat' && <><path d="M21 11.5c0 4.7-4 8-9 8a11 11 0 0 1-3-.4L4 22l.9-5.3A7.3 7.3 0 0 1 3 11.5C3 6.8 7 3.5 12 3.5s9 3.3 9 8Z" /><path d="M8 11.5h.1m3.9 0h.1m3.9 0h.1" stroke-width="2.5" /></>}
</svg>
