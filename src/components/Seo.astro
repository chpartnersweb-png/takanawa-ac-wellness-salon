---
import { getImage } from 'astro:assets';
import room from '../assets/line_oa_chat_261028_111814.jpg';
import logo from '../assets/brand/logo-transparent-v1.png';
import { salon } from '../data/salon';
import { SITE_URL, canonicalUrl } from '../data/site.mjs';
import { seo, createStructuredData } from '../data/seo';

const canonical = canonicalUrl(Astro.url.pathname);
const [socialImage, businessLogo] = await Promise.all([
  getImage({ src: room, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 88 }),
  getImage({ src: logo, width: 512, format: 'png' }),
]);
const imageUrl = new URL(socialImage.src, SITE_URL).href;
const logoUrl = new URL(businessLogo.src, SITE_URL).href;
const structuredData = createStructuredData({ canonical, imageUrl, logoUrl });
---
<title>{seo.title}</title>
<meta name="description" content={seo.description} />
<meta name="robots" content={seo.robots} />
<link rel="canonical" href={canonical} />
<link rel="sitemap" type="application/xml" href={new URL('sitemap.xml', SITE_URL).href} />
<meta property="og:locale" content={seo.locale} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content={salon.name} />
<meta property="og:title" content={seo.title} />
<meta property="og:description" content={seo.description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:secure_url" content={imageUrl} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={seo.imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={seo.title} />
<meta name="twitter:description" content={seo.description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={seo.imageAlt} />
<script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
