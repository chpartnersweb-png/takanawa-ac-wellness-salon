---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import HeroSection from '../components/HeroSection.astro';
import PartnerSection from '../components/PartnerSection.astro';
import PhilosophySection from '../components/PhilosophySection.astro';
import SalonSection from '../components/SalonSection.astro';
import BookingSection from '../components/BookingSection.astro';
import AccessSection from '../components/AccessSection.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MobileActions from '../components/MobileActions.astro';
---

<BaseLayout>
  <SiteHeader />
  <main id="main">
    <HeroSection />
    <PartnerSection />
    <PhilosophySection />
    <SalonSection />
    <BookingSection />
    <AccessSection />
  </main>
  <SiteFooter />
  <MobileActions />
</BaseLayout>
