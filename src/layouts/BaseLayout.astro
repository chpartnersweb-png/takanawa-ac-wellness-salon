---
import { getImage } from 'astro:assets';
import { salon } from '../data/salon';
import hero from '../assets/generated/hero-desktop-v1.png';
import '../styles/global.css';
const title = `${salon.name}｜健康・美容・姿勢をサポート`;
const description = '高輪台駅から徒歩3分。高輪鍼灸 AC Wellness Salonは、健康・美容・姿勢をサポートする2席のサロンです。ミセス・インターナショナル2027公式パートナー。サロンの詳細・ご予約はホットペッパービューティーへ。';
const ogImage = await getImage({ src: hero, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 85 });
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const ogUrl = Astro.site ? new URL(ogImage.src, Astro.site).href : undefined;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: salon.name,
  description,
  ...(canonical ? { url: canonical.href } : {}),
  ...(ogUrl ? { image: ogUrl } : {}),
  telephone: salon.phoneHref.replace('tel:0', '+81-'),
  address: {
    '@type': 'PostalAddress',
    postalCode: salon.postalCode,
    addressRegion: '東京都',
    addressLocality: '港区',
    streetAddress: `高輪3-7-6 ${salon.building} ${salon.floor}`,
    addressCountry: 'JP',
  },
  hasMap: salon.links.maps,
  sameAs: [salon.links.instagram, salon.links.line, salon.links.booking, salon.links.google],
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: salon.openingDays,
    opens: salon.openingTime,
    closes: salon.closingTime,
  }],
};
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f3ea" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/ac-mark.svg" />
    {canonical && <link rel="canonical" href={canonical.href} />}
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={salon.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical.href} />}
    {ogUrl && <meta property="og:image" content={ogUrl} />}
    <meta property="og:image:alt" content="柔らかな光と、凛とした女性の後ろ姿" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Noto+Sans+JP:wght@400;500;600&family=Noto+Serif+JP:wght@400;500;600&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
  </head>
  <body>
    <a class="skip-link" href="#main">本文へスキップ</a>
    <slot />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
